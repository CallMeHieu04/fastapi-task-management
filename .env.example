# ==============================================================================
# TaskHub API — Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="TaskHub"
PROJECT_DESCRIPTION="TaskHub API — Task Management & Collaboration System"
VERSION="0.3.0"
API_V1_STR="/api/v1"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# For Local Development (SQLite):
DATABASE_URL="sqlite+aiosqlite:///./taskhub.db"
# For Docker / Production (PostgreSQL):
# DATABASE_URL="postgresql+asyncpg://taskhub_user:taskhub_password@localhost:5432/taskhub_db"
DB_ECHO=False

# ------------------------------------------------------------------------------
# Security & JWT Configuration
# ------------------------------------------------------------------------------
# Minimum 32 characters secret key (required for production)
SECRET_KEY="taskhub-insecure-secret-key-for-local-dev-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Cache Configuration (Redis with graceful In-Memory fallback)
# ------------------------------------------------------------------------------
CACHE_ENABLED=True
CACHE_TTL_SECONDS=120
REDIS_URL="redis://localhost:6379/0"
# For Docker Compose:
# REDIS_URL="redis://redis:6379/0"
# POSTGRES_USER="taskhub_user"
# POSTGRES_PASSWORD="change-me-in-production"
# POSTGRES_DB="taskhub_db"
