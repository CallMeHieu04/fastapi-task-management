PROJECT_NAME="TaskHub API"
API_V1_STR="/api/v1"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Database
DATABASE_URL="sqlite+aiosqlite:///./taskhub.db"
DB_ECHO=False

# Security & JWT
SECRET_KEY="taskhub-secret-key-32-chars-long-secure-production-2026-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
